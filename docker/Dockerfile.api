# syntax=docker/dockerfile:1.7
FROM python:3.11-slim AS builder
ENV PIP_NO_CACHE_DIR=1 PIP_DISABLE_PIP_VERSION_CHECK=1 PYTHONDONTWRITEBYTECODE=1
RUN apt-get update && apt-get install -y --no-install-recommends build-essential git && rm -rf /var/lib/apt/lists/*
RUN python -m venv /opt/venv
ENV PATH="/opt/venv/bin:${PATH}"

# Install CPU-only torch first to avoid pulling large CUDA wheels
RUN pip install --index-url https://download.pytorch.org/whl/cpu "torch>=2.2"

# pyproject.toml declares readme = "README.md" and packages = ["devpilot"]
# Both README.md and devpilot/ must be present in the builder context so hatchling can build the wheel
COPY pyproject.toml README.md ./
COPY devpilot ./devpilot
RUN pip install ".[full]"

FROM python:3.11-slim AS runtime
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PATH="/opt/venv/bin:${PATH}" HF_HOME=/home/devpilot/.cache/huggingface
RUN apt-get update && apt-get install -y --no-install-recommends git curl && rm -rf /var/lib/apt/lists/* \
    && useradd --create-home --uid 10001 --shell /usr/sbin/nologin devpilot \
    && mkdir -p /app/.devpilot /workspace && chown -R devpilot:devpilot /app /workspace

COPY --from=builder /opt/venv /opt/venv
USER devpilot
WORKDIR /app

# eval/ is copied to /app/eval so that CLI and API routes (e.g. devpilot eval, POST /api/eval/runs)
# can lazily import eval.dataset and eval.runner without requiring eval to be packaged into the wheel
COPY --chown=devpilot:devpilot eval /app/eval

VOLUME ["/app/.devpilot"]
EXPOSE 8000
HEALTHCHECK --interval=15s --timeout=5s --start-period=20s --retries=3 CMD curl -fsS http://localhost:8000/api/health || exit 1
CMD ["python","-m","uvicorn","devpilot.api.app:app","--host","0.0.0.0","--port","8000"]
