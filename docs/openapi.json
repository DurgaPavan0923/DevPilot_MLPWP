  "components": {
    "schemas": {
      "AgentConfigPreset": {
        "type": "string",
        "enum": [
          "basic",
          "fixed_rag",
          "full"
        ],
        "title": "AgentConfigPreset",
        "description": "Evaluation harness agent configurations."
      },
      "ApprovalRequest": {
        "properties": {
          "approved": {
            "type": "boolean",
            "title": "Approved"
          },
          "reason": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Reason"
          }
        },
        "type": "object",
        "required": [
          "approved"
        ],
        "title": "ApprovalRequest"
      },
      "CreateSessionRequest": {
        "properties": {
          "session_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Session Id",
            "description": "Optional client session ID, generated if omitted"
          },
          "preset": {
            "$ref": "#/components/schemas/AgentConfigPreset",
            "default": "full"
          },
          "provider": {
            "type": "string",
            "title": "Provider",
            "default": "mock"
          },
          "model": {
            "type": "string",
            "title": "Model",
            "default": "mock-model"
          },
          "repo_path": {
            "type": "string",
            "title": "Repo Path",
            "default": "."
          },
          "permission_mode": {
            "$ref": "#/components/schemas/PermissionMode",
            "default": "auto-safe"
          },
          "task": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Task"
          }
        },
        "type": "object",
        "title": "CreateSessionRequest"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "LaunchEvalRequest": {
        "properties": {
          "suite_path": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Suite Path"
          },
          "presets": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Presets"
          },
          "seeds": {
            "items": {
              "type": "integer"
            },
            "type": "array",
            "title": "Seeds"
          },
          "concurrency": {
            "type": "integer",
            "title": "Concurrency",
            "default": 4
          },
          "limit": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Limit"
          }
        },
        "type": "object",
        "title": "LaunchEvalRequest"
      },
      "PermissionMode": {
        "type": "string",
        "enum": [
          "read-only",
          "ask",
          "auto-safe",
          "full"
        ],
        "title": "PermissionMode",
        "description": "Safety permission modes governing tool executions."
      },
      "RollbackRequest": {
        "properties": {
          "snapshot_id": {
            "type": "string",
            "title": "Snapshot Id",
            "default": "baseline"
          }
        },
        "type": "object",
        "title": "RollbackRequest"
      },
      "StartTaskRequest": {
        "properties": {
          "instruction": {
            "type": "string",
            "title": "Instruction"
          }
        },
        "type": "object",
        "required": [
          "instruction"
        ],
        "title": "StartTaskRequest"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}