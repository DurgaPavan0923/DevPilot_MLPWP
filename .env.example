# DevPilot Environment Configuration Example

# Application Settings
DEVPILOT_ENV=development
DEVPILOT_DEBUG=false
DEVPILOT_LOG_LEVEL=INFO
DEVPILOT_HOST=0.0.0.0
DEVPILOT_PORT=8000
DEVPILOT_SESSION_DIR=.devpilot/sessions
DEVPILOT_DATABASE_URL=sqlite+aiosqlite:///.devpilot/devpilot.db

# LLM Provider API Keys
ANTHROPIC_API_KEY=sk-ant-api03-...
OPENAI_API_KEY=sk-proj-...
GEMINI_API_KEY=AIzaSy...
DEEPSEEK_API_KEY=sk-...

# Ollama / Local Model Settings
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=deepseek-coder:6.7b

# Custom OpenAI-Compatible Endpoint
OPENAI_COMPATIBLE_BASE_URL=https://api.together.xyz/v1
OPENAI_COMPATIBLE_API_KEY=your_key_here
OPENAI_COMPATIBLE_MODEL=meta-llama/Llama-3-70b-chat-hf

# Default LLM Selection
DEVPILOT_DEFAULT_PROVIDER=openai
DEVPILOT_DEFAULT_MODEL=gpt-4o-mini
DEVPILOT_DEFAULT_TEMPERATURE=0.0

# Safety & Permissions
DEVPILOT_PERMISSION_MODE=auto-safe
DEVPILOT_SANDBOX_ENABLED=true
DEVPILOT_SANDBOX_TIMEOUT_SEC=120
DEVPILOT_MAX_STEPS=30
DEVPILOT_MAX_COST_USD=2.00
DEVPILOT_MAX_TOTAL_TOKENS=250000
