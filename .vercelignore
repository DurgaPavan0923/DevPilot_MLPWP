# Root .vercelignore for DevPilot
# Excludes root backend, tests, docker, evaluation engines, and large weights to ensure frontend-only deploys never exceed bundle limits.
# Note: leading slashes ensure that nested directories such as web/app/eval and web/app/docs are NOT excluded.

/devpilot/
/eval/
/tests/
/docker/
/notebooks/
/results/
/output_images/
/scripts/
/docs/
/eval_repos/

# Python virtual environment and caches
/.venv/
__pycache__/
*.py[cod]

# Binary weights and databases
*.pt
*.bin
*.safetensors
*.db
*.sqlite3
/.devpilot/

# OS and logs
*.log
.DS_Store
Thumbs.db
